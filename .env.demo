# =============================================================================
# Zero-Trust Access Gateway — Demo Environment (Slice A: walking skeleton)
# Loaded by docker-compose.demo.yml. Safe to commit: all secrets are
# demo-only placeholders; production stacks use .env (not committed).
# =============================================================================

NODE_ENV=development
PORT=3000

# Future slices flip these on (per PRD). Slice A reads but ignores them.
DEMO_MODE=true

# CORS / rate limit — generous for a stage demo
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000

# -----------------------------------------------------------------------------
# mTLS — paths inside the gateway container; ./certs is mounted at /app/certs
# CN allowlist matches certs minted by scripts/gen-certs.sh
# -----------------------------------------------------------------------------
MTLS_CA_CERT_PATH=/app/certs/ca.crt
MTLS_CLIENT_CERT_PATH=/app/certs/gateway.crt
MTLS_CLIENT_KEY_PATH=/app/certs/gateway.key
MTLS_ALLOWED_SUBJECTS=orders-service,users-service

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_USER=ztgateway
POSTGRES_PASSWORD=demo-only-do-not-deploy
POSTGRES_DB=ztgateway
DATABASE_URL=postgresql://ztgateway:demo-only-do-not-deploy@localhost:5432/ztgateway

# -----------------------------------------------------------------------------
# JWT — HS256. Demo only.
# -----------------------------------------------------------------------------
JWT_SECRET=demo-jwt-secret-that-is-at-least-32-chars-long!

# -----------------------------------------------------------------------------
# Trust score — leave defaults
# -----------------------------------------------------------------------------
TRUST_KNOWN_THRESHOLD=3
TRUST_DECAY_HALFLIFE_MS=604800000
TRUST_ANOMALY_WARMUP_N=20
TRUST_FREQUENCY_WINDOW_MS=60000
TRUST_FREQUENCY_NORMAL_MAX=30

# -----------------------------------------------------------------------------
# Honeypot
# -----------------------------------------------------------------------------
BLACKLIST_TTL_MS=3600000
HONEYPOT_ROUTES=

# -----------------------------------------------------------------------------
# Hashcash + policy thresholds — production defaults are preserved (#11).
# The presenter lands a deterministic happy path by passing
#   -H "x-demo-trust-score: 0.0"
# on the curl; that override is honoured only when DEMO_MODE=true and the
# real provider math is unchanged. The high-risk demonstration uses
#   -H "x-demo-trust-score: 0.7"   (above HASHCASH_TRIGGER_THRESHOLD, below DENY)
# -----------------------------------------------------------------------------
HASHCASH_HMAC_SECRET=demo-hashcash-hmac-secret-32-chars-min!!!!!
HASHCASH_CHALLENGE_TTL_MS=120000
HASHCASH_USED_NONCE_CAPACITY=10000
HASHCASH_TRIGGER_THRESHOLD=0.6
HASHCASH_DIFFICULTY_MIN=8
HASHCASH_DIFFICULTY_MAX=12
POLICY_CHALLENGE_THRESHOLD=0.7
POLICY_DENY_THRESHOLD=0.9

# -----------------------------------------------------------------------------
# MFA
# -----------------------------------------------------------------------------
MFA_JWT_SECRET=demo-mfa-jwt-secret-that-is-32-chars-min!!
MFA_TOTP_ENCRYPTION_KEY=ZGVtby1tZmEtdG90cC1lbmNyeXB0aW9uLWtleS0zMi1ieXRlcyE=
MFA_CHALLENGE_TTL_MS=300000
MFA_TOKEN_TTL_MS=600000
MFA_RATE_LIMIT_MAX=50
MFA_RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# Proxy — orders-service and users-service registered (SSRF allowlist). Service
# names resolve to the docker-compose services of the same name.
# -----------------------------------------------------------------------------
PROXY_SERVICE_REGISTRY={"orders":"https://orders-service:8443","users":"https://users-service:8443"}
PROXY_CB_VOLUME_THRESHOLD=5
PROXY_CB_ERROR_THRESHOLD=50
PROXY_CB_RESET_TIMEOUT=10000
PROXY_MAX_RETRIES=3
BOPLA_POLICY_PATH=policy/field-policy.json
