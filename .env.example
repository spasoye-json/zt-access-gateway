# =============================================================================
# Zero-Trust Access Gateway — Environment Variables (Phase 1)
# Copy this file to .env and fill in real values before starting.
# NEVER commit .env — it is in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# CORS
# In production, set to your exact origin (e.g. https://app.example.com).
# Wildcard is only safe for local development.
# -----------------------------------------------------------------------------
CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Rate Limiting (per IP)
# RATE_LIMIT_WINDOW_MS: sliding window in milliseconds (default 60 s)
# RATE_LIMIT_MAX: maximum requests per window before 429 is returned
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# mTLS Certificate Paths (used by MtlsService / ProxyService)
# Paths are relative to the working directory or absolute.
# -----------------------------------------------------------------------------
MTLS_CA_CERT_PATH=/path/to/ca.pem
MTLS_CLIENT_CERT_PATH=/path/to/client.pem
MTLS_CLIENT_KEY_PATH=/path/to/client-key.pem

# Comma-separated list of allowed CN values on downstream server certificates.
MTLS_ALLOWED_SUBJECTS=service-cn-1,service-cn-2

# -----------------------------------------------------------------------------
# PostgreSQL (used by Docker Compose and application)
# -----------------------------------------------------------------------------
POSTGRES_USER=ztgateway
# CHANGE_ME: set a strong, unique password — do not use this placeholder in production
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ztgateway
DATABASE_URL=postgresql://ztgateway:CHANGE_ME@localhost:5432/ztgateway

# -----------------------------------------------------------------------------
# Phase 3: JWT Auth (D-11)
# JWT_SECRET is required (min 32 chars). HS256 by default.
# Optional asymmetric/JWKS variants below — leave blank for HS256.
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_minimum_32_characters_long_secret_here
# JWT_PUBLIC_KEY=
# JWKS_URI=
# JWT_ISSUER=
# JWT_AUDIENCE=

# -----------------------------------------------------------------------------
# Phase 4: Trust score (TRST / D-21)
# -----------------------------------------------------------------------------
# Prior ALLOWs required before device/IP count as "known" (reputation)
TRUST_KNOWN_THRESHOLD=3
# Exponential decay half-life for favorable deltas (ms); default 7 days
TRUST_DECAY_HALFLIFE_MS=604800000
# Min ALLOW records before behavior-anomaly signal contributes
TRUST_ANOMALY_WARMUP_N=20
# Sliding window for request-frequency signal (ms)
TRUST_FREQUENCY_WINDOW_MS=60000
# Requests per window considered "normal" for frequency signal
TRUST_FREQUENCY_NORMAL_MAX=30

# -----------------------------------------------------------------------------
# Phase 2: JA4H + Honeypot
# -----------------------------------------------------------------------------
# How long a blacklisted JA4H fingerprint stays blocked (ms). Default: 1 hour.
BLACKLIST_TTL_MS=3600000
# Additional honeypot routes as JSON array (optional). Hardcoded defaults always active.
# Example: HONEYPOT_ROUTES='["/secret-admin","/api/keys"]'
HONEYPOT_ROUTES=

# -----------------------------------------------------------------------------
# Phase 5: Hashcash PoW (D-17)
# -----------------------------------------------------------------------------
# Separate HMAC secret for PoW challenge signing (D-05). Min 32 chars.
# MUST be distinct from JWT_SECRET and MFA_JWT_SECRET.
HASHCASH_HMAC_SECRET=replace_with_at_least_32_random_chars_xxxxxxxxxxxxx
# Challenge TTL in milliseconds. Default 120000 (120s).
HASHCASH_CHALLENGE_TTL_MS=120000
# Used-nonce LRU capacity (single-use replay defense, in-memory).
HASHCASH_USED_NONCE_CAPACITY=10000
# Trust score above which PoW activates. Strict greater than (D-08).
HASHCASH_TRIGGER_THRESHOLD=0.7
# Difficulty curve bounds (bits of leading zeros required).
# Production: 18 / 22 preserves D-10 (score 0.7→18, 0.8→20, 0.9→22).
# Test/CI: 4 / 4 collapses range for fast e2e solves (~16 iterations).
HASHCASH_DIFFICULTY_MIN=18
HASHCASH_DIFFICULTY_MAX=22
