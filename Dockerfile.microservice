FROM node:18-alpine

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY src ./src
COPY microservices ./microservices
COPY nest-cli.json tsconfig.json ./

# Build the application
RUN npm run build

# Create non-root user
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nestjs -u 1001
USER nestjs

EXPOSE 3001 3002 3003

CMD ["sh", "-c", "node dist/microservices/users-service/main-https.js & node dist/microservices/orders-service/main-https.js & node dist/microservices/permissions-service/main-https.js & wait"]