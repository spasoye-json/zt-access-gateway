# Demo upstream microservice image (used by docker-compose.demo.yml).
# Slice A produces only orders-service; users-service follows in a later slice.
# Override `command:` in compose to pick the specific service entrypoint.
FROM node:18-alpine

WORKDIR /app

RUN apk add --no-cache python3 make g++

COPY package*.json ./
RUN npm ci

# Microservices ship as a separate compilation unit so they don't depend on
# the NestJS build graph in src/.
COPY microservices ./microservices
COPY tsconfig.json tsconfig.microservices.json ./

RUN node_modules/.bin/tsc -p tsconfig.microservices.json

RUN addgroup -g 1001 -S nodejs && adduser -S nestjs -u 1001 -G nodejs
USER nestjs

EXPOSE 8443

CMD ["node", "dist/microservices/orders-service/main-https.js"]
