{
  "name": "zt-access-gateway-microservices",
  "version": "1.0.0",
  "description": "Placeholder microservices for the Zero-Trust Access Gateway",
  "scripts": {
    "start:users": "ts-node users-service/main.ts",
    "start:orders": "ts-node orders-service/main.ts",
    "start:permissions": "ts-node permissions-service/main.ts",
    "start:all": "concurrently \"npm run start:users\" \"npm run start:orders\" \"npm run start:permissions\""
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  }
}